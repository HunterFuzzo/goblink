{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download",
      "destination": "/downloads/Blink.dmg",
      "permanent": false
    },
    {
      "source": "/download/mac",
      "destination": "/downloads/Blink.dmg",
      "permanent": false
    },
    {
      "source": "/download/windows",
      "destination": "/downloads/Blink-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/win",
      "destination": "/downloads/Blink-Setup.exe",
      "permanent": false
    },
    {
      "source": "/Blink.dmg",
      "destination": "/downloads/Blink.dmg",
      "permanent": false
    },
    {
      "source": "/Blink-Setup.exe",
      "destination": "/downloads/Blink-Setup.exe",
      "permanent": false
    },
    {
      "source": "/download/ios",
      "destination": "/downloads/BlinkRemote.ipa",
      "permanent": false
    },
    {
      "source": "/download/ipa",
      "destination": "/downloads/BlinkRemote.ipa",
      "permanent": false
    },
    {
      "source": "/download/android",
      "destination": "/downloads/BlinkRemote.apk",
      "permanent": false
    },
    {
      "source": "/download/apk",
      "destination": "/downloads/BlinkRemote.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhook/stripe",
      "destination": "/api/auth?path=webhook/stripe"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?path=$1"
    },
    {
      "source": "/api/ticket/(.*)",
      "destination": "/api/ticket?path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
